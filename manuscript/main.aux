\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Paired evaluator acceptance on the identical frozen HumanEval corpus ($N=164$: 155 correct, 9 incorrect). Wilson 95\% confidence intervals are shown for $\kappa $ and $\tau $. Log-likelihood evidence from acceptance is $E=\log _2(\tau /\kappa )$; its marginal intervals are transformed two-sided 95\% Koopman score intervals with the Miettinen--Nurminen correction. The execution arm has zero observed false acceptances, so its plug-in $\hat  E$ and the upper interval endpoint are unbounded.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:results}{{I}{7}{Paired evaluator acceptance on the identical frozen HumanEval corpus ($N=164$: 155 correct, 9 incorrect). Wilson 95\% confidence intervals are shown for $\kappa $ and $\tau $. Log-likelihood evidence from acceptance is $E=\log _2(\tau /\kappa )$; its marginal intervals are transformed two-sided 95\% Koopman score intervals with the Miettinen--Nurminen correction. The execution arm has zero observed false acceptances, so its plug-in $\hat E$ and the upper interval endpoint are unbounded}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Fresh complete-response MBPP paired results, five model families. One greedy candidate per task, frozen and hashed before evaluation; both arms judge the same candidate in fresh contexts. ``Paired'' is the number of candidates with assigned ground truth and a terminal verdict from both arms; $n_{T=0}$ is the incorrect stratum of that paired set, and $\kappa =P(A^{\mathrm  H}{=}1\mid T{=}0)$, $\tau =P(A^{\mathrm  H}{=}1\mid T{=}1)$ are strict-verdict false- and true-acceptance rates with 95\% Wilson score intervals. $p_{\mathrm  {Holm}}$ is the five-family Holm-adjusted value for the paired incorrect-stratum McNemar contrast. Malformed arms are excluded from paired denominators and reported as counts in the text, never imputed.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:kappa_mbpp}{{II}{7}{Fresh complete-response MBPP paired results, five model families. One greedy candidate per task, frozen and hashed before evaluation; both arms judge the same candidate in fresh contexts. ``Paired'' is the number of candidates with assigned ground truth and a terminal verdict from both arms; $n_{T=0}$ is the incorrect stratum of that paired set, and $\kappa =P(A^{\mathrm H}{=}1\mid T{=}0)$, $\tau =P(A^{\mathrm H}{=}1\mid T{=}1)$ are strict-verdict false- and true-acceptance rates with 95\% Wilson score intervals. $p_{\mathrm {Holm}}$ is the five-family Holm-adjusted value for the paired incorrect-stratum McNemar contrast. Malformed arms are excluded from paired denominators and reported as counts in the text, never imputed}{table.2}{}}
